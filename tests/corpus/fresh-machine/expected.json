{
  "tool": "0.3.0",
  "schema": 2,
  "manifest": "fresh",
  "dry_run": true,
  "skills_target": "<CASE>/home/.agents/skills",
  "link_mode": "symlink",
  "claude": true,
  "agy": false,
  "desired": 8,
