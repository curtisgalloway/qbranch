    {
      "op": "link",
      "label": "t-a2",
      "src": "<CASE>/home/src/mkt-repo/skills/t-a2",
      "dst": "<CASE>/home/.agents/skills/t-a2",
      "note": ""
    },
    {
      "op": "link",
      "label": "claude-skills",
      "src": "<CASE>/home/.agents/skills",
      "dst": "<CASE>/home/.claude/skills",
      "note": ""
    }
  ],
  "plugin_actions": [
    {
      "op": "add-mkt",
      "label": "mkt1",
      "argv": [
        "claude",
        "plugin",
        "marketplace",
        "add",
        "example/mkt1"
      ]
    },
    {
      "op": "add-mkt",
      "label": "claude-plugins-official",
      "argv": [
        "claude",
        "plugin",
        "marketplace",
        "add",
        "anthropics/claude-plugins-official"
      ]
    },
    {
      "op": "install",
      "label": "p1@claude-plugins-official",
      "argv": [
        "claude",
        "plugin",
        "install",
        "p1@claude-plugins-official",
        "--scope",
        "user"
      ]
    },
    {
      "op": "install",
      "label": "q@mkt1",
      "argv": [
        "claude",
        "plugin",
        "install",
        "q@mkt1",
        "--scope",
        "user"
      ]
    }
  ],
  "unlinked_repo_skills": [],
  "messages": [
    {
      "level": "skipped",
      "text": "AGENTS.md: <CASE>/home/.gemini/AGENTS.md (Antigravity not installed)"
    },
    {
      "level": "info",
