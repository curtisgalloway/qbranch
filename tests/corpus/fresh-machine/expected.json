      "dst": "<CASE>/home/.agents/skills/beta",
      "note": ""
    },
    {
      "op": "link",
      "label": "CLAUDE.md",
      "src": "<CASE>/root/claude-code/CLAUDE.md",
      "dst": "<CASE>/home/.claude/CLAUDE.md",
      "note": ""
    },
    {
      "op": "link",
      "label": "plain-one",
      "src": "<CASE>/home/src/plain-repo/skills/plain-one",
      "dst": "<CASE>/home/.agents/skills/plain-one",
      "note": ""
    },
    {
      "op": "link",
      "label": "plain-two",
      "src": "<CASE>/home/src/plain-repo/skills/plain-two",
      "dst": "<CASE>/home/.agents/skills/plain-two",
