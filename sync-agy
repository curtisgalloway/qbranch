"""Sync agent state into local Antigravity (agy) directories based on a JSON manifest.

A manifest is a JSON file at manifests/<name>.json with this shape:

    {
      "name": "macbook",
      "description": "...",
      "skills": [
        { "name": "learn", "path": "${AGENT_SKILLS_REPO}/skills/learn" }
      ],
      "links": [
        { "src": "${AGENT_SKILLS_REPO}/agy/AGENTS.md",
          "dst": "${HOME}/.gemini/AGENTS.md" }
      ],
      "agy_links": [
        { "src": "${AGENT_SKILLS_REPO}/agy/settings.json",
          "dst": "${HOME}/.gemini/antigravity-cli/settings.json" }
      ]
    }

`skills` is linked into the Antigravity skills target directory (~/.gemini/antigravity-cli/skills).
`links` are general links linked by both Claude and agy.
`agy_links` are Antigravity-specific links.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEFAULT_SKILLS_TARGET = Path.home() / ".gemini" / "antigravity-cli" / "skills"
STATE_FILE_NAME = ".agent-skills-state.json"


def expand_path(raw: str) -> Path:
    s = raw.replace("${AGENT_SKILLS_REPO}", str(REPO))
    s = os.path.expandvars(s)
    return Path(s).expanduser()


def load_manifest(name: str) -> dict:
    p = REPO / "manifests" / f"{name}.json"
    if not p.exists():
        sys.exit(f"manifest not found: {p}\n"
                 f"available: {', '.join(list_manifests()) or '(none)'}")
    return json.loads(p.read_text())


def list_manifests() -> list[str]:
    d = REPO / "manifests"
    return sorted(p.stem for p in d.glob("*.json")) if d.is_dir() else []


def load_state(state_path: Path) -> dict:
    if not state_path.exists():
        return {"manifest": None, "links": []}
    try:
        data = json.loads(state_path.read_text())
    except json.JSONDecodeError:
        return {"manifest": None, "links": []}
    if "names" in data and "links" not in data:
        skills_target = state_path.parent
        data["links"] = [str(skills_target / n) for n in data["names"]]
    data.setdefault("links", [])
    return data


def save_state(state_path: Path, manifest_name: str, links: list[Path]) -> None:
    state_path.write_text(json.dumps({
        "manifest": manifest_name,
        "linked_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "links": sorted({str(p) for p in links}),
    }, indent=2) + "\n")


def collect_desired(manifest: dict, skills_target: Path) -> list[tuple[str, Path, Path]]:
    """Return (label, src, dst) tuples from the manifest."""
    out: list[tuple[str, Path, Path]] = []
    seen: set[Path] = set()

    for entry in manifest.get("skills", []):
        name = entry["name"]
        src = expand_path(entry["path"])
        dst = skills_target / name
        if dst in seen:
            sys.exit(f"duplicate destination in manifest: {dst}")
        seen.add(dst)
        out.append((name, src, dst))

    for entry in manifest.get("links", []):
        src = expand_path(entry["src"])
        dst = expand_path(entry["dst"])
        label = entry.get("label") or dst.name
        if dst in seen:
            sys.exit(f"duplicate destination in manifest: {dst}")
        seen.add(dst)
        out.append((label, src, dst))

    for entry in manifest.get("agy_links", []):
        src = expand_path(entry["src"])
        dst = expand_path(entry["dst"])
        label = entry.get("label") or dst.name
        if dst in seen:
            sys.exit(f"duplicate destination in manifest: {dst}")
        seen.add(dst)
        out.append((label, src, dst))

    return out


def offer_agy(failures: list[str]) -> None:
    """If agy is on PATH, offer to run it with the failure context."""
    if not shutil.which("agy"):
        return
    if not sys.stdin.isatty():
        return
    lines = "\n".join(f"  - {f}" for f in failures)
    prompt = (
        f"The sync-agy script failed with the following problems:\n"
        f"{lines}\n"
        f"Please help me fix them."
    )
    print(f"\nRun agy to fix this? [y/N] ", end="", flush=True)
    try:
        answer = input().strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if answer == "y":
        os.execvp("agy", ["agy", prompt])


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Sync agent state from a manifest into local Antigravity (agy) directories.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--manifest", "-m",
                    help="Manifest name under manifests/ (without .json). "
                         "Default: last used, or 'default' on first run.")
    ap.add_argument("--skills-target", "-t",
                    default=str(DEFAULT_SKILLS_TARGET),
                    help=f"Where 'skills' entries get linked "
                         f"(default: {DEFAULT_SKILLS_TARGET}). The state file "
                         f"also lives here.")
    ap.add_argument("--dry-run", "-n", action="store_true",
                    help="Print plan without changing the filesystem.")
    ap.add_argument("--list", action="store_true",
                    help="List available manifests and exit.")
    args = ap.parse_args()

    if args.list:
        for n in list_manifests():
            print(n)
        return 0

    skills_target = Path(args.skills_target).expanduser()
    skills_target.mkdir(parents=True, exist_ok=True)
    state_path = skills_target / STATE_FILE_NAME

    state = load_state(state_path)
    manifest_name = args.manifest or state.get("manifest") or "default"
    manifest = load_manifest(manifest_name)

    desired = collect_desired(manifest, skills_target)
    desired_dsts = {dst for _, _, dst in desired}
    previous_dsts = {Path(p) for p in state.get("links", [])}

    actions: list[tuple[str, str, Path | None, Path, str]] = []

    for dst in sorted(previous_dsts - desired_dsts):
        if dst.is_symlink():
            actions.append(("remove", dst.name, None, dst,
                            f"-> {dst.readlink()} (not in manifest)"))

    for label, src, dst in desired:
        if not src.exists():
            actions.append(("MISS", label, src, dst, "source missing"))
            continue
        if dst.is_symlink():
            cur_raw = Path(os.readlink(dst))
            cur = (dst.parent / cur_raw).resolve() if not cur_raw.is_absolute() else cur_raw.resolve()
            if cur == src.resolve():
                actions.append(("ok", label, src, dst, ""))
            else:
                actions.append(("relink", label, src, dst, f"was: {cur_raw}"))
        elif dst.exists():
            actions.append(("WARN", label, src, dst,
                            "non-symlink at destination — leaving alone"))
        else:
            actions.append(("link", label, src, dst, ""))

    label_w = max((len(label) for _, label, *_ in actions), default=8)
    for op, label, src, dst, note in actions:
        srcs = f"{dst} -> {src}" if src else f"{dst}"
        print(f"  {op:<6} {label:<{label_w}}  {note}  {srcs}".rstrip())

    if not actions:
        print("  (nothing to do)")

    print()
    print(f"manifest={manifest_name}  desired={len(desired_dsts)}  "
          f"skills_target={skills_target}")

    if args.dry_run:
        print("(dry run — no changes made)")
        return 0

    final: list[Path] = []
    had_error = False
    failures: list[str] = []
    for op, label, src, dst, note in actions:
        try:
            if op == "remove":
                dst.unlink()
            elif op == "relink":
                dst.unlink()
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.symlink_to(src)
                final.append(dst)
            elif op == "link":
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.symlink_to(src)
                final.append(dst)
            elif op == "ok":
                final.append(dst)
            elif op == "WARN":
                msg = f"{label}: non-symlink at {dst} — refusing to overwrite"
                print(f"ERROR: {msg}", file=sys.stderr)
                failures.append(msg)
                had_error = True
            elif op == "MISS":
                msg = f"{label}: source missing at {src}"
                print(f"ERROR: {msg}", file=sys.stderr)
                failures.append(msg)
                had_error = True
        except OSError as e:
            msg = f"{label} ({dst}): {e}"
            print(f"ERROR: {msg}", file=sys.stderr)
            failures.append(msg)
            had_error = True

    save_state(state_path, manifest_name, final)

    if failures:
        offer_agy(failures)

    return 1 if had_error else 0


if __name__ == "__main__":
    raise SystemExit(main())
