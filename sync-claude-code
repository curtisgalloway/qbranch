#!/usr/bin/env python3
"""Sync agent state into the local agent's directories based on a JSON manifest.

A manifest is a JSON file at manifests/<name>.json with this shape:

    {
      "name": "ozone",
      "description": "...",
      "skills": [
        { "name": "learn", "path": "${AGENT_SKILLS_REPO}/skills/learn" },
        { "name": "paniolo", "repo": "git@github.com:user/paniolo.git",
          "path": "skills/paniolo" }
      ],
      "links": [
        { "src": "${AGENT_SKILLS_REPO}/claude-code/CLAUDE.md",
          "dst": "${HOME}/.claude/CLAUDE.md" },
        { "src": "${AGENT_SKILLS_REPO}/claude-code/hooks/permission-notify.sh",
          "dst": "${HOME}/.claude/hooks/permission-notify.sh" }
      ]
    }

`skills` is shorthand for "link this into the skills target directory under
the entry's name". `links` is the general form: any source linked to any
destination. Use `links` to sync CLAUDE.md, hooks, settings, or anything else
that lives elsewhere under ~/.claude/ — or under future agents' directories
(e.g. ~/.gemini/...).

Skills entries support two source forms:
  - path-based:  { "name": "...", "path": "<local-path>" }
  - repo-based:  { "name": "...", "repo": "<git-url>", "path": "<repo-relative-path>" }

For repo-based entries the script looks up ~/src/<repo-name> first (by
convention); if that directory is a git checkout it is used directly.
Otherwise the repo is cloned (and kept updated) under
~/.claude/skill-repos/<repo-name>/.

Both local path and dst fields support:
  - ${AGENT_SKILLS_REPO}  (auto-resolved to this repo's root)
  - any environment variable via ${VAR}
  - a leading ~

The script:
  - Symlinks each entry into its destination, creating parent dirs as needed.
  - Refuses to overwrite a non-symlink at the destination.
  - Tracks every destination it created in
    <skills_target>/.agent-skills-state.json so swapping manifests removes
    stale symlinks even when they pointed at paths outside this repo.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEFAULT_SKILLS_TARGET = Path.home() / ".claude" / "skills"
STATE_FILE_NAME = ".agent-skills-state.json"
PUBLIC_SKILLS_REPO = Path.home() / "src" / "public-skills"
PUBLIC_SKILLS_DIR = PUBLIC_SKILLS_REPO / "skills"
SKILL_REPOS_CACHE = Path.home() / ".claude" / "skill-repos"


def expand_path(raw: str) -> Path:
    s = raw.replace("${AGENT_SKILLS_REPO}", str(REPO))
    s = os.path.expandvars(s)
    return Path(s).expanduser()


def repo_name_from_url(url: str) -> str:
    """Extract 'paniolo' from 'git@github.com:user/paniolo.git'."""
    name = url.rstrip("/").split("/")[-1]
    if name.endswith(".git"):
        name = name[:-4]
    return name


def resolve_repo_local(repo_url: str) -> Path:
    """Return the local root of repo_url, cloning if necessary.

    Checks ~/src/<name> first (convention); if that's a git checkout it is
    used as-is. Otherwise clones into ~/.claude/skill-repos/<name>/ and pulls
    on every subsequent sync.
    """
    name = repo_name_from_url(repo_url)

    local = Path.home() / "src" / name
    if local.is_dir() and (local / ".git").exists():
        return local

    cache = SKILL_REPOS_CACHE / name
    if cache.is_dir() and (cache / ".git").exists():
        result = subprocess.run(
            ["git", "-C", str(cache), "pull", "--ff-only"],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            print(f"warning: git pull failed for {name}: {result.stderr.strip()}")
    else:
        SKILL_REPOS_CACHE.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", repo_url, str(cache)], check=True)
    return cache


def resolve_skill_src(entry: dict) -> Path:
    """Return the source Path for a skills entry (path-based or repo-based)."""
    if "repo" in entry:
        return resolve_repo_local(entry["repo"]) / entry["path"]
    return expand_path(entry["path"])


def parse_git_skill_url(arg: str) -> tuple[str, str, str]:
    """Parse a git:// shorthand → (skill_name, repo_url, skill_path).

    Two forms:
      Short:  git://<local-name>[/<path>]
        First segment has no dot → look up ~/src/<name> for the remote URL.
        git://paniolo/skills/paniolo
          → name=paniolo  repo=<origin of ~/src/paniolo>  path=skills/paniolo

      Full:   git://<host>/<owner>/<repo>[/<path>]
        First segment contains a dot → construct git@host:owner/repo.git.
        git://github.com/user/paniolo/skills/hdmicap
          → name=hdmicap  repo=git@github.com:user/paniolo.git  path=skills/hdmicap
    """
    rest = arg[len("git://"):]
    parts = rest.split("/")

    if "." not in parts[0]:
        repo_name = parts[0]
        path_parts = parts[1:]
        local = Path.home() / "src" / repo_name
        if not local.is_dir() or not (local / ".git").exists():
            sys.exit(
                f"git:// short form: ~/src/{repo_name} not found or not a git repo\n"
                f"use full form: git://<host>/<owner>/<repo>[/<path>]"
            )
        result = subprocess.run(
            ["git", "-C", str(local), "remote", "get-url", "origin"],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            sys.exit(f"could not get remote URL for ~/src/{repo_name}: {result.stderr.strip()}")
        repo_url = result.stdout.strip()
        skill_path = "/".join(path_parts) if path_parts else f"skills/{repo_name}"
        skill_name = path_parts[-1] if path_parts else repo_name
        return skill_name, repo_url, skill_path

    if len(parts) < 3:
        sys.exit(
            f"invalid git:// skill URL: {arg!r}\n"
            f"expected: git://<host>/<owner>/<repo>[/<path/to/skill>]"
        )
    host, owner, repo_part = parts[0], parts[1], parts[2]
    path_parts = parts[3:]
    repo_name = repo_part[:-4] if repo_part.endswith(".git") else repo_part
    repo_url = f"git@{host}:{owner}/{repo_name}.git"
    skill_path = "/".join(path_parts) if path_parts else f"skills/{repo_name}"
    skill_name = path_parts[-1] if path_parts else repo_name
    return skill_name, repo_url, skill_path


def load_manifest(name: str) -> dict:
    p = REPO / "manifests" / f"{name}.json"
    if not p.exists():
        sys.exit(f"manifest not found: {p}\n"
                 f"available: {', '.join(list_manifests()) or '(none)'}")
    return json.loads(p.read_text())


def list_manifests() -> list[str]:
    d = REPO / "manifests"
    return sorted(p.stem for p in d.glob("*.json")) if d.is_dir() else []


def load_state(state_path: Path) -> dict:
    if not state_path.exists():
        return {"manifest": None, "links": []}
    try:
        data = json.loads(state_path.read_text())
    except json.JSONDecodeError:
        return {"manifest": None, "links": []}
    if "names" in data and "links" not in data:
        skills_target = state_path.parent
        data["links"] = [str(skills_target / n) for n in data["names"]]
    data.setdefault("links", [])
    return data


def save_state(state_path: Path, manifest_name: str, links: list[Path]) -> None:
    state_path.write_text(json.dumps({
        "manifest": manifest_name,
        "linked_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "links": sorted({str(p) for p in links}),
    }, indent=2) + "\n")


def collect_desired(manifest: dict, skills_target: Path) -> list[tuple[str, Path, Path]]:
    """Return (label, src, dst) tuples from the manifest."""
    out: list[tuple[str, Path, Path]] = []
    seen: set[Path] = set()

    for entry in manifest.get("skills", []):
        name = entry["name"]
        src = resolve_skill_src(entry)
        dst = skills_target / name
        if dst in seen:
            sys.exit(f"duplicate destination in manifest: {dst}")
        seen.add(dst)
        out.append((name, src, dst))

    for entry in manifest.get("links", []):
        src = expand_path(entry["src"])
        dst = expand_path(entry["dst"])
        label = entry.get("label") or dst.name
        if dst in seen:
            sys.exit(f"duplicate destination in manifest: {dst}")
        seen.add(dst)
        out.append((label, src, dst))

    return out


def collect_public_skills(
    skills_target: Path, taken_dsts: set[Path]
) -> tuple[list[tuple[str, Path, Path]], list[str]]:
    """Implicit skill entries from ~/src/public-skills/skills/.

    Returns (entries, warnings). Manifest entries win on name collision; the
    conflicting public-skills entry is skipped and surfaced in `warnings`.
    """
    entries: list[tuple[str, Path, Path]] = []
    warnings: list[str] = []
    if not PUBLIC_SKILLS_DIR.is_dir():
        return entries, warnings
    for child in sorted(PUBLIC_SKILLS_DIR.iterdir()):
        if not child.is_dir() or not (child / "SKILL.md").exists():
            continue
        name = child.name
        dst = skills_target / name
        if dst in taken_dsts:
            warnings.append(
                f"public-skills/{name}: manifest already defines {dst}, skipped"
            )
            continue
        entries.append((name, child, dst))
    return entries, warnings


def offer_claude(failures: list[str]) -> None:
    """If claude is on PATH, offer to run it with the failure context."""
    if not shutil.which("claude"):
        return
    if not sys.stdin.isatty():
        return
    lines = "\n".join(f"  - {f}" for f in failures)
    prompt = (
        f"The sync-claude-code script failed with the following problems:\n"
        f"{lines}\n"
        f"Please help me fix them."
    )
    print(f"\nRun claude to fix this? [y/N] ", end="", flush=True)
    try:
        answer = input().strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if answer == "y":
        os.execvp("claude", ["claude", prompt])


def add_skill_to_manifest(
    manifest_name: str,
    skill_name: str,
    repo: str | None = None,
    skill_path: str | None = None,
) -> bool:
    """Add skill_name to manifest. Returns True if manifest was modified."""
    p = REPO / "manifests" / f"{manifest_name}.json"
    manifest = json.loads(p.read_text())
    existing = {e["name"] for e in manifest.get("skills", [])}
    if skill_name in existing:
        return False
    if repo:
        entry: dict = {
            "name": skill_name,
            "repo": repo,
            "path": skill_path or f"skills/{skill_name}",
        }
    else:
        entry = {
            "name": skill_name,
            "path": f"${{AGENT_SKILLS_REPO}}/skills/{skill_name}",
        }
    manifest.setdefault("skills", []).append(entry)
    p.write_text(json.dumps(manifest, indent=2) + "\n")
    return True


def remove_skill_from_manifest(manifest_name: str, skill_name: str) -> bool:
    """Remove skill_name from manifest. Returns True if manifest was modified."""
    p = REPO / "manifests" / f"{manifest_name}.json"
    manifest = json.loads(p.read_text())
    before = manifest.get("skills", [])
    after = [e for e in before if e.get("name") != skill_name]
    if len(after) == len(before):
        return False
    manifest["skills"] = after
    p.write_text(json.dumps(manifest, indent=2) + "\n")
    return True


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Sync agent state from a manifest into the local filesystem.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--manifest", "-m",
                    help="Manifest name under manifests/ (without .json). "
                         "Default: last used, or 'default' on first run.")
    ap.add_argument("--skills-target", "-t",
                    default=str(DEFAULT_SKILLS_TARGET),
                    help=f"Where 'skills' entries get linked "
                         f"(default: {DEFAULT_SKILLS_TARGET}). The state file "
                         f"also lives here.")
    ap.add_argument("--dry-run", "-n", action="store_true",
                    help="Print plan without changing the filesystem.")
    ap.add_argument("--list", action="store_true",
                    help="List available manifests and exit.")
    ap.add_argument("--add-skill", "-a", metavar="SKILL",
                    help="Add SKILL to the target manifest(s) and exit. "
                         "Path defaults to ${AGENT_SKILLS_REPO}/skills/SKILL.")
    ap.add_argument("--remove-skill", "-r", metavar="SKILL",
                    help="Remove SKILL from the target manifest(s) and exit.")
    ap.add_argument("--repo", metavar="URL",
                    help="Git repo URL for the skill (used with --add-skill). "
                         "On sync, ~/src/<repo-name> is checked first; "
                         "otherwise the repo is cloned to ~/.claude/skill-repos/.")
    ap.add_argument("--skill-path", metavar="PATH",
                    help="Path within the repo (used with --add-skill --repo). "
                         "Defaults to skills/<skill-name>.")
    ap.add_argument("--all", dest="all_manifests", action="store_true",
                    help="With --add-skill/--remove-skill: apply to every manifest "
                         "in manifests/. Prints a reminder to sync each machine afterwards.")
    args = ap.parse_args()

    if args.list:
        for n in list_manifests():
            print(n)
        return 0

    if args.add_skill and args.remove_skill:
        sys.exit("--add-skill and --remove-skill are mutually exclusive")

    if args.add_skill or args.remove_skill:
        adding = bool(args.add_skill)
        skill_name = args.add_skill if adding else args.remove_skill

        repo_url = args.repo
        skill_path_arg = args.skill_path

        if adding and skill_name.startswith("git://"):
            skill_name, repo_url, skill_path_arg = parse_git_skill_url(skill_name)

        if adding:
            if repo_url:
                local_root = Path.home() / "src" / repo_name_from_url(repo_url)
                if not local_root.is_dir():
                    print(f"note: {local_root} not found — will clone on sync")
            else:
                skill_dir = REPO / "skills" / skill_name
                if not skill_dir.is_dir():
                    print(f"error: {skill_dir} not found")
                    return 2

        add_kwargs = {}
        if adding and repo_url:
            add_kwargs["repo"] = repo_url
            add_kwargs["skill_path"] = skill_path_arg

        def fn_with_kwargs(mname: str, sname: str) -> bool:
            if adding:
                return add_skill_to_manifest(mname, sname, **add_kwargs)
            return remove_skill_from_manifest(mname, sname)

        if args.all_manifests:
            targets = list_manifests()
            if not targets:
                sys.exit("no manifests found")
            for mname in targets:
                changed = fn_with_kwargs(mname, skill_name)
                if adding:
                    status = "added" if changed else "already present"
                else:
                    status = "removed" if changed else "not present"
                print(f"  {status:<15}  {mname}")
            print(f"\nRemember to run sync-claude-code on each machine to apply.")
            return 0
        else:
            state_path = Path(args.skills_target).expanduser() / STATE_FILE_NAME
            state = load_state(state_path)
            manifest_name = args.manifest or state.get("manifest") or "default"
            changed = fn_with_kwargs(manifest_name, skill_name)
            if adding:
                verb, already = "added to", "already in"
            else:
                verb, already = "removed from", "not in"
            if changed:
                print(f"{skill_name!r} {verb} manifest '{manifest_name}'")
                print(f"Run sync-claude-code to apply.")
            else:
                print(f"{skill_name!r} {already} manifest '{manifest_name}'")
            return 0

    skills_target = Path(args.skills_target).expanduser()
    skills_target.mkdir(parents=True, exist_ok=True)
    state_path = skills_target / STATE_FILE_NAME

    state = load_state(state_path)
    manifest_name = args.manifest or state.get("manifest") or "default"
    manifest = load_manifest(manifest_name)

    desired = collect_desired(manifest, skills_target)
    taken_dsts = {dst for _, _, dst in desired}
    public_entries, public_warnings = collect_public_skills(skills_target, taken_dsts)
    desired.extend(public_entries)

    if not PUBLIC_SKILLS_DIR.is_dir():
        print(
            f"note: {PUBLIC_SKILLS_REPO} not found — consider cloning it "
            f"for additional skills"
        )
    for w in public_warnings:
        print(f"warning: {w}")

    desired_dsts = {dst for _, _, dst in desired}
    previous_dsts = {Path(p) for p in state.get("links", [])}

    actions: list[tuple[str, str, Path | None, Path, str]] = []

    for dst in sorted(previous_dsts - desired_dsts):
        if dst.is_symlink():
            actions.append(("remove", dst.name, None, dst,
                            f"-> {dst.readlink()} (not in manifest)"))

    for label, src, dst in desired:
        if not src.exists():
            actions.append(("MISS", label, src, dst, "source missing"))
            continue
        if dst.is_symlink():
            cur_raw = Path(os.readlink(dst))
            cur = (dst.parent / cur_raw).resolve() if not cur_raw.is_absolute() else cur_raw.resolve()
            if cur == src.resolve():
                actions.append(("ok", label, src, dst, ""))
            else:
                actions.append(("relink", label, src, dst, f"was: {cur_raw}"))
        elif dst.exists():
            actions.append(("WARN", label, src, dst,
                            "non-symlink at destination — leaving alone"))
        else:
            actions.append(("link", label, src, dst, ""))

    label_w = max((len(label) for _, label, *_ in actions), default=8)
    for op, label, src, dst, note in actions:
        srcs = f"{dst} -> {src}" if src else f"{dst}"
        print(f"  {op:<6} {label:<{label_w}}  {note}  {srcs}".rstrip())

    if not actions:
        print("  (nothing to do)")

    manifest_skill_srcs = {
        expand_path(e["path"]).resolve()
        for e in manifest.get("skills", [])
        if "repo" not in e
    }
    unsynced = sorted(
        child.name
        for child in (REPO / "skills").iterdir()
        if child.is_dir() and child.resolve() not in manifest_skill_srcs
    )
    if unsynced:
        print(f"not in manifest: {', '.join(unsynced)}")

    print()
    print(f"manifest={manifest_name}  desired={len(desired_dsts)}  "
          f"skills_target={skills_target}")

    if args.dry_run:
        print("(dry run — no changes made)")
        return 0

    final: list[Path] = []
    had_error = False
    failures: list[str] = []
    for op, label, src, dst, note in actions:
        try:
            if op == "remove":
                dst.unlink()
            elif op == "relink":
                dst.unlink()
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.symlink_to(src)
                final.append(dst)
            elif op == "link":
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.symlink_to(src)
                final.append(dst)
            elif op == "ok":
                final.append(dst)
            elif op == "WARN":
                msg = f"{label}: non-symlink at {dst} — refusing to overwrite"
                print(f"ERROR: {msg}", file=sys.stderr)
                failures.append(msg)
                had_error = True
            elif op == "MISS":
                msg = f"{label}: source missing at {src}"
                print(f"ERROR: {msg}", file=sys.stderr)
                failures.append(msg)
                had_error = True
        except OSError as e:
            msg = f"{label} ({dst}): {e}"
            print(f"ERROR: {msg}", file=sys.stderr)
            failures.append(msg)
            had_error = True

    save_state(state_path, manifest_name, final)

    if failures:
        offer_claude(failures)

    return 1 if had_error else 0


if __name__ == "__main__":
    raise SystemExit(main())
